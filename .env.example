# ── AI Provider — set ONE of the following ─────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env. For EAS builds use `eas env:create` or
# set these as secrets/vars in your build service instead.

# Option A: Gemini API Key (free at https://aistudio.google.com/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Option B: GitHub PAT (free at https://github.com/settings/tokens, no scopes needed)
# This uses GitHub Models (gpt-4o-mini) — 1440 requests/day free tier
EXPO_PUBLIC_GITHUB_PAT=your_github_pat

# ── Expo CLI Workaround ─────────────────────────────────────
# Skips broken fetch in Expo CLI 0.17.13 (bodyStream error)
EXPO_NO_DOCTOR=1
EXPO_BUNDLER_SKIP_DEPENDENCY_VERSION_VALIDATION=1

# ── Supabase Configuration ──────────────────────────────────
# Create a project at https://supabase.com
# Go to Project Settings → API and copy the values below:
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key