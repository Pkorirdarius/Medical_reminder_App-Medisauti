# ── AI Provider ─────────────────────────────────────────
# Providers are tried in order: GitHub → Groq → Gemini (whichever is set).
# All are FREE, no billing account or credit card required.

# 1) GitHub Models (gpt-4o-mini) — 1440 requests/day
#    Generate at https://github.com/settings/tokens (no scopes needed)
EXPO_PUBLIC_GITHUB_PAT=your_github_pat

# 2) Groq (llama-3.3-70b-versatile) — ~14,400 requests/day, 30 RPM
#    Generate at https://console.groq.com/keys (free, no card)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key

# ── Expo CLI Workaround ─────────────────────────────────────
# Skips broken fetch in Expo CLI 0.17.13 (bodyStream error)
EXPO_NO_DOCTOR=1
EXPO_BUNDLER_SKIP_DEPENDENCY_VERSION_VALIDATION=1

# ── Supabase Configuration ──────────────────────────────────
# Create a project at https://supabase.com
# Go to Project Settings → API and copy the values below:
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key