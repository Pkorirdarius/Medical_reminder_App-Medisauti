# ── AI Provider ─────────────────────────────────────────
# Providers are tried in order: Groq → Gemini (whichever is set).
# All are FREE, no billing account or credit card required.

# 1) Groq (openai/gpt-oss-120b) — free tier, ~14,400 requests/day, 30 RPM
#    Generate at https://console.groq.com/keys (free, no card)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key

# 2) Gemini (gemini-2.0-flash) — backup when Groq fails/unavailable.
#    Generate at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# ── Expo CLI Workaround ─────────────────────────────────────
# Skips broken fetch in Expo CLI 0.17.13 (bodyStream error)
EXPO_NO_DOCTOR=1
EXPO_BUNDLER_SKIP_DEPENDENCY_VERSION_VALIDATION=1

# ── Supabase Configuration ──────────────────────────────────
# Create a project at https://supabase.com
# Go to Project Settings → API and copy the values below:
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key